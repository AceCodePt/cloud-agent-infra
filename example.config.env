# Provider: oci (active) | hetzner | gcp
PROVIDER="oci"

# Shared
TF_VAR_instance_name="cloud-agent"
TF_VAR_ssh_user="youruser"
TF_VAR_machine_type="VM.Standard.A1.Flex"   # OCI Ampere A1 (Always Free eligible)
TF_VAR_ocpus="2"                            # free tier: up to 4
TF_VAR_memory_in_gbs="12"                   # free tier: up to 24

# OCI (Oracle Cloud Infrastructure) — home region il-jerusalem-1 (Always Free).
# Sign up at signup.cloud.oracle.com, pick Israel Central (Jerusalem), then:
#   mkdir -p ~/.oci
#   openssl genrsa -out ~/.oci/oci_api_key.pem 2048
#   openssl rsa -pubout -in ~/.oci/oci_api_key.pem -out ~/.oci/oci_api_key_public.pem
# Upload the public key: Console -> Profile -> API Keys -> Add API Key, then
# copy the tenancy/user OCIDs and fingerprint into config.env.
OCI_TENANCY_OCID="ocid1.tenancy.oc1..aaaa..."
OCI_USER_OCID="ocid1.user.oc1..aaaa..."
OCI_FINGERPRINT="ab:cd:ef:..."
OCI_PRIVATE_KEY_PATH="$HOME/.oci/oci_api_key.pem"
TF_VAR_region="il-jerusalem-1"

# Hetzner (reference path — set PROVIDER=hetzner and these take effect).
# API token (read & write): console.hetzner.com -> Security -> API Tokens.
HETZNER_API_KEY="your-hetzner-api-token"
TF_VAR_hcloud_token="$HETZNER_API_KEY"
TF_VAR_location="nbg1"
TF_VAR_data_disk_size_gb="20"

# GCP (unused while PROVIDER=oci; kept for switching back). Region lives in
# TF_VAR_region, so the value above wins when PROVIDER=oci — set PROVIDER=gcp
# and these take effect.
TF_VAR_project_id="your-project-id"
TF_VAR_zone="me-west1-a"

# Tailscale API key: https://login.tailscale.com/admin/settings/keys
# bootstrap.sh uses it to mint a fresh SINGLE-USE, pre-approved auth key per
# build, and cleanup.sh uses it to delete the stale node so the next build keeps
# the clean MagicDNS name. Terraform never sees this key — only the minted
# auth key, which goes into tailscale.auto.tfvars (git-ignored).
#
# It is tailnet-admin scoped (mint keys, delete any device), so prefer a scoped
# OAuth client (auth_keys + devices) if you want something longer-lived; API
# keys expire in 90 days max.
TAILSCALE_API_KEY="tskey-api-..."

# Optional durable state (Hetzner Object Storage, S3-compatible). Kept although
# state is currently local: HETZNER_API_KEY cannot manage Object Storage (S3
# rejects Bearer auth), so these two S3-style keys are the only way to move
# state off this laptop. Empty = local tfstate.
#HETZNER_OBJECT_ACCESS_KEY=""
#HETZNER_OBJECT_SECRET_KEY=""
#TF_STATE_BUCKET="my-tfstate-bucket"
#HZ_OBJECT_REGION="nbg1"

# Optional: TTL of the minted auth key (default 86400). It is consumed within
# minutes of the apply, so this only bounds how long an unused key stays valid.
#TAILSCALE_KEY_TTL_SECONDS="86400"

# Optional fallback, ONLY if you are not using TAILSCALE_API_KEY. Must be
# reusable and unexpired.
#
# Do not set both. terraform/tailscale.auto.tfvars (written by mint) outranks
# TF_VAR_* env vars in Terraform's variable precedence, so a key here would be
# ignored on every normal build and only take effect if that file went missing —
# silently baking a long-spent key into the VM instead of failing the build.
#TF_VAR_tailscale_auth_key="tskey-auth-..."

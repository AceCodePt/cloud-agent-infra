#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=scripts/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/scripts/lib.sh"

usage() {
  cat <<'EOF'
Usage: ./run <command> [args]

  up [--quick]     THE command. Converge everything to the verified good state
                   from whatever state it is in now, and prove it. Idempotent,
                   and never destroys anything — safe to run any time.

Lifecycle
  bootstrap        State bucket + backend.tf + terraform init + mint a one-off auth key
  plan             Show the Terraform plan
  apply            Create/update the infrastructure
  wait [--packages] Block until the VM is on the tailnet and its startup script
                   finished; --packages also waits for the deferred browser stack
  phone            Re-key the phone to the VM's CURRENT notify pubkey (idempotent)
  verify [--quick] Assert the entire end state (non-zero exit on any drift)
  verify-browser   Just the browser stack (chromium/Xvfb/zram/CDP). Runs as a
                   sidecar inside verify; standalone for when phase B was still
                   installing and verify SKIPped it.
  rebuild          FROM SCRATCH: cleanup -> bootstrap -> apply -> wait -> phone -> verify
                   Destroys the data disk. Use `up` unless you mean that.
  cleanup [flags]  Tear down + delete the tailnet node (--yes, --keep-bucket, --keep-files, --force)

Agents
  measure [args]   Sample the box's real resource use and report peaks, so
                   sizing is a measurement rather than an opinion. Uses PSS (not
                   RSS) because per-client isolation means several copies of the
                   same binaries sharing pages. --seconds N --interval S
                   --label X --json
  lsp-probe [args] Measure what one language server costs on a real repo. The
                   LSP, not opencode, is the dominant per-client cost, and it
                   needs no model or API key to measure. --cmd "vtsls --stdio"
                   --root DIR --ext .ts --files N --settle S --quiet S --json

                   To measure a REAL agent session rather than an idle one, the
                   drivers in scripts/ (drive-agent-loop.mjs, agent-stress.mjs,
                   box-*.sh) are hand-driven over ssh — deliberately not wired in
                   here, because each needs a running `opencode serve` with a
                   provider connected. See docs/measurements.md — the concurrency
                   ramp (slow-but-alive, never halt) lives there.

Browser
  browser [url]   Reach the box's virtual display and drive the SHARED browser
                  in it, by hand, over VNC through an SSH tunnel. The browser
                  is infra; whatever runs in it (a login, an app under test) is
                  up to the caller. BROWSER_CMD / BROWSER_PROFILE_DIR /
                  VNC_LOCAL_PORT override the defaults.
  browser --stop  Stop the browser (SIGTERM, flushes cookies) and x11vnc

Tailscale
  mint-key         Mint a fresh one-off auth key into terraform/tailscale.auto.tfvars
  check-key        Assert that key is still usable (apply does this for you)
  rekey [--reboot] Get a fresh key into an EXISTING VM. `apply` alone cannot:
                   GCE only runs startup-script at boot, so a metadata-only
                   update is never read and the key is never consumed.
  list-nodes       List tailnet devices
  delete-node [n]  Delete this instance's node (and any -N duplicate)

Misc
  ssh [args]       SSH to the box over Tailscale (interactive)
  tf <args>        Raw terraform in terraform/ (e.g. ./run tf state list)
  fmt              terraform fmt
  validate         terraform fmt -check + validate + bash -n on every script
  check            validate + verify
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
help | -h | --help) usage ;;

up) scripts/up.sh "$@" ;;

bootstrap) scripts/bootstrap.sh "$@" ;;
plan)
  load_config
  tf plan "$@"
  ;;
apply)
  load_config
  scripts/tailscale-api.sh check
  tf apply "$@"
  ;;
wait) scripts/wait-ready.sh "$@" ;;
phone) scripts/provision-phone.sh "$@" ;;
verify) scripts/verify.sh "$@" ;;
verify-browser) scripts/verify-browser.sh "$@" ;;
cleanup) scripts/cleanup.sh "$@" ;;

rebuild)
  for step in \
    "scripts/cleanup.sh" \
    "scripts/bootstrap.sh" \
    "APPLY" \
    "scripts/wait-ready.sh" \
    "scripts/provision-phone.sh" \
    "scripts/verify.sh"; do
    printf '\n\033[1m=== %s\033[0m\n' "$step"
    if [[ "$step" == "APPLY" ]]; then
      load_config
      scripts/tailscale-api.sh check
      tf apply -auto-approve
    else
      "$step"
    fi
  done
  printf '\n\033[1;32mRebuild complete and verified.\033[0m\n'
  ;;

measure)
  load_config
  ssh_vm "cat > /tmp/measure-resources.py" <scripts/measure-resources.py
  ssh_vm "sudo -n python3 /tmp/measure-resources.py $(printf '%q ' "$@")"
  ;;

lsp-probe)
  load_config
  ssh_vm "cat > /tmp/lsp-probe.mjs" <scripts/lsp-probe.mjs
  ssh_vm "node /tmp/lsp-probe.mjs $(printf '%q ' "$@")"
  ;;

browser) scripts/browser.sh "$@" ;;

mint-key) scripts/tailscale-api.sh mint ;;
check-key) scripts/tailscale-api.sh check ;;
rekey) scripts/rekey.sh "$@" ;;
list-nodes) scripts/tailscale-api.sh list ;;
delete-node) scripts/tailscale-api.sh delete-node "$@" ;;

ssh)
  load_config
  ssh -o StrictHostKeyChecking=accept-new "$SSH_USER@$INSTANCE" "$@"
  ;;
tf)
  load_config
  tf "$@"
  ;;
fmt) tf fmt ;;
validate)
  load_config
  tf fmt -check
  [[ -d "$TF_DIR/.terraform" ]] || tf init -backend=false -input=false >/dev/null
  tf validate
  for f in scripts/*.sh run; do bash -n "$f" || die "$f does not parse"; done
  echo "all scripts parse"
  ;;
check)
  "$0" validate
  "$0" verify
  ;;

*)
  echo "Unknown command: $cmd" >&2
  echo >&2
  usage >&2
  exit 1
  ;;
esac
